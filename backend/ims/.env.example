# ==============================================================================
# PIMS Backend Environment Configuration Example
# ==============================================================================

# Database
DB_NAME=ims
DB_PORT=3306
DB_PASSWORD=sapassword
DB_USER=ims_user
DB_USER_PASSWORD=ims_password

# Backend Server & Security
BACKEND_PORT=8086
SERVER_PORT=8085
JPA_DDL_AUTO=update
JWT_SECRET=your_jwt_secret_key_at_least_64_characters_long_for_hmac_sha256
JWT_EXPIRATION_MS=10800000
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000

# Camunda 7 Admin Credentials
CAMUNDA_ADMIN_PASSWORD=Admin@123

# Mail Service (Gmail SMTP App Password hoặc SMTP Doanh Nghiệp)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@saigonbank.com.vn
MAIL_PASSWORD=your-smtp-app-password
MAIL_FROM=your-email@saigonbank.com.vn
