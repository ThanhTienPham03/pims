<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true">
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="LOG_FILE" source="logging.file.name" defaultValue="logs/log.txt"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

 
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
    <logger name="saigonbank.fit.ims.service.AuthService" level="INFO" additivity="true">
        <appender-ref ref="FILE"/>
    </logger>
    <logger name="saigonbank.fit.ims.service.OtpStore" level="INFO" additivity="true">
        <appender-ref ref="FILE"/>
    </logger>
    <logger name="saigonbank.fit.ims.service.EmailService" level="INFO" additivity="true">
        <appender-ref ref="FILE"/>
    </logger>
    <logger name="org.camunda" level="WARN"/>
    <logger name="saigonbank.fit.ims.worker" level="INFO" additivity="true">
        <appender-ref ref="FILE"/>
    </logger>
    <logger name="saigonbank.fit.ims.listener" level="INFO" additivity="true">
        <appender-ref ref="FILE"/>
    </logger>
    <logger name="saigonbank.fit.ims.service.CamundaWorkflowService" level="INFO" additivity="true">
        <appender-ref ref="FILE"/>
    </logger>
    <logger name="saigonbank.fit.ims.service.CamundaDmnService" level="INFO" additivity="true">
        <appender-ref ref="FILE"/>
    </logger>
    <logger name="saigonbank.fit.ims.service.AuditLogService" level="INFO" additivity="true">
        <appender-ref ref="FILE"/>
    </logger>
</configuration>
