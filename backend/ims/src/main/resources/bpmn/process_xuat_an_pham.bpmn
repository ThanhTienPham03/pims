<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_XuatAnPham" targetNamespace="http://saigonbank.fit/ims/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.22.0">
  <bpmn:error id="Error_ThangDaKhoa_Xuat" name="Loi thang da khoa" errorCode="ERR_MONTH_LOCKED" />
  <bpmn:error id="Error_ViPhamACQT" name="ACQT phai lap phieu xuat rieng" errorCode="ERR_ACQT_MIXING" />
  <bpmn:error id="Error_KhongDuTonKho" name="Loi xuat vuot ton kho" errorCode="ERR_INSUFFICIENT_STOCK" />
  <bpmn:error id="Error_DuLieuXuatKhongHopLe" name="Loi du lieu phieu xuat khong hop le" errorCode="ERR_INVALID_EXPORT_DATA" />
  <bpmn:process id="Process_XuatAnPham" name="Quy Trinh Xuat An Pham" isExecutable="true" camunda:historyTimeToLive="365">
    <bpmn:laneSet id="LaneSet_Xuat">
      <bpmn:lane id="Lane_HeThong_Xuat" name="He Thong IMS (Tu dong)">
        <bpmn:flowNodeRef>Task_KiemTraThangKhoa_Xuat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KiemTraACQT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KiemTraTonKho</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_KiemTraTon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TinhThanhTienHetTon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_LoiThangKhoa_Xuat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_LoiTonKho</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_LoiKho</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_LoiACQT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_ThangKhoa_Xuat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_XuatThanhCong</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GhiAuditLog_Xuat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CapSoVaGhiNhan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_LoiDuLieu_Xuat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_LoiDuLieu_Xuat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1213k32</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TinhThanhTienConTon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_LoiACQT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NguoiDung_Xuat" name="Nguoi Lap Phieu / Don Vi De Nghi">
        <bpmn:flowNodeRef>Start_Xuat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NhapThongTinPhieuXuat</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Xuat" name="1. Bat dau: Yeu cau xuat an pham">
      <bpmn:outgoing>Flow_Start_ToNhapThongTin</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_NhapThongTinPhieuXuat" name="2. Tiep nhan thong tin phieu xuat" camunda:assignee="${username}" camunda:candidateGroups="ROLE_INVENTORY,ROLE_REQUESTER">
      <bpmn:incoming>Flow_Start_ToNhapThongTin</bpmn:incoming>
      <bpmn:outgoing>Flow_NhapThongTin_ToKiemTraThang</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_KiemTraThangKhoa_Xuat" name="3. Kiem tra trang thai khoa thang" camunda:delegateExpression="${genericTaskDelegate}">
      <bpmn:incoming>Flow_NhapThongTin_ToKiemTraThang</bpmn:incoming>
      <bpmn:outgoing>Flow_ThangOK_ToKiemTraACQT</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_ThangKhoa_Xuat" attachedToRef="Task_KiemTraThangKhoa_Xuat">
      <bpmn:outgoing>Flow_LoiThangX_ToEnd</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_ThangKhoa_Xuat" errorRef="Error_ThangDaKhoa_Xuat" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_KiemTraACQT" name="4. Kiem tra quy tac dac biet ACQT" camunda:delegateExpression="${genericTaskDelegate}">
      <bpmn:incoming>Flow_ThangOK_ToKiemTraACQT</bpmn:incoming>
      <bpmn:outgoing>Flow_AcqtOK_ToKiemTraTon</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_LoiACQT" attachedToRef="Task_KiemTraACQT">
      <bpmn:outgoing>Flow_LoiACQT_ToEnd</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_ACQT" errorRef="Error_ViPhamACQT" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_KiemTraTonKho" name="5. Kiem tra ton kho va lay don gia xuat" camunda:delegateExpression="${genericTaskDelegate}">
      <bpmn:incoming>Flow_AcqtOK_ToKiemTraTon</bpmn:incoming>
      <bpmn:outgoing>Flow_TonOK_ToGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_LoiKho" attachedToRef="Task_KiemTraTonKho">
      <bpmn:outgoing>Flow_LoiKho_ToEnd</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_Kho" errorRef="Error_KhongDuTonKho" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="GW_KiemTraTon" name="Con ton sau xuat?" default="Flow_ConTon_ToTinhThanhTien">
      <bpmn:incoming>Flow_TonOK_ToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ConTon_ToTinhThanhTien</bpmn:outgoing>
      <bpmn:outgoing>Flow_HetTon_ToTinhThanhTienHet</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_TinhThanhTienConTon" name="7a. Tinh Thanh tien xuat (con ton)" camunda:delegateExpression="${genericTaskDelegate}">
      <bpmn:incoming>Flow_ConTon_ToTinhThanhTien</bpmn:incoming>
      <bpmn:outgoing>Flow_ConTon_ToCapSo</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_TinhThanhTienHetTon" name="7b. Tinh Thanh tien xuat (xuat het ton)" camunda:delegateExpression="${genericTaskDelegate}">
      <bpmn:incoming>Flow_HetTon_ToTinhThanhTienHet</bpmn:incoming>
      <bpmn:outgoing>Flow_HetTon_ToCapSo</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CapSoVaGhiNhan" name="8. Cap so STT/NHOM-YYYY" camunda:delegateExpression="${exportProcessDelegate}">
      <bpmn:incoming>Flow_16cn2k2</bpmn:incoming>
      <bpmn:outgoing>Flow_CapSo_ToAuditLog</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_LoiDuLieu_Xuat" attachedToRef="Task_CapSoVaGhiNhan">
      <bpmn:outgoing>Flow_LoiDuLieu_ToEnd</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_DuLieu_Xuat" errorRef="Error_DuLieuXuatKhongHopLe" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_GhiAuditLog_Xuat" name="9. Ghi nhan Audit Log" camunda:delegateExpression="${genericTaskDelegate}">
      <bpmn:incoming>Flow_CapSo_ToAuditLog</bpmn:incoming>
      <bpmn:outgoing>Flow_AuditLogX_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_XuatThanhCong" name="Hoan tat xuat kho thanh cong">
      <bpmn:incoming>Flow_AuditLogX_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_LoiThangKhoa_Xuat" name="Tu choi: Thang da khoa so">
      <bpmn:incoming>Flow_LoiThangX_ToEnd</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorDef_EndThangKhoa_Xuat" errorRef="Error_ThangDaKhoa_Xuat" />
    </bpmn:endEvent>
    <bpmn:endEvent id="End_LoiACQT" name="Tu choi: Vi pham quy tac ACQT">
      <bpmn:incoming>Flow_LoiACQT_ToEnd</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorDef_EndACQT" errorRef="Error_ViPhamACQT" />
    </bpmn:endEvent>
    <bpmn:endEvent id="End_LoiTonKho" name="Tu choi: Ton kho khong du">
      <bpmn:incoming>Flow_LoiKho_ToEnd</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorDef_EndKho" errorRef="Error_KhongDuTonKho" />
    </bpmn:endEvent>
    <bpmn:endEvent id="End_LoiDuLieu_Xuat" name="Tu choi: Du lieu phieu xuat khong hop le">
      <bpmn:incoming>Flow_LoiDuLieu_ToEnd</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorDef_EndDuLieu" errorRef="Error_DuLieuXuatKhongHopLe" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_ToNhapThongTin" sourceRef="Start_Xuat" targetRef="Task_NhapThongTinPhieuXuat" />
    <bpmn:sequenceFlow id="Flow_NhapThongTin_ToKiemTraThang" sourceRef="Task_NhapThongTinPhieuXuat" targetRef="Task_KiemTraThangKhoa_Xuat" />
    <bpmn:sequenceFlow id="Flow_ThangOK_ToKiemTraACQT" sourceRef="Task_KiemTraThangKhoa_Xuat" targetRef="Task_KiemTraACQT" />
    <bpmn:sequenceFlow id="Flow_AcqtOK_ToKiemTraTon" sourceRef="Task_KiemTraACQT" targetRef="Task_KiemTraTonKho" />
    <bpmn:sequenceFlow id="Flow_TonOK_ToGateway" sourceRef="Task_KiemTraTonKho" targetRef="GW_KiemTraTon" />
    <bpmn:sequenceFlow id="Flow_ConTon_ToTinhThanhTien" name="Con ton sau xuat" sourceRef="GW_KiemTraTon" targetRef="Task_TinhThanhTienConTon" />
    <bpmn:sequenceFlow id="Flow_HetTon_ToTinhThanhTienHet" name="Xuat het ton" sourceRef="GW_KiemTraTon" targetRef="Task_TinhThanhTienHetTon">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.getVariable('xuatHetTon') == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ConTon_ToCapSo" sourceRef="Task_TinhThanhTienConTon" targetRef="Gateway_1213k32" />
    <bpmn:sequenceFlow id="Flow_HetTon_ToCapSo" sourceRef="Task_TinhThanhTienHetTon" targetRef="Gateway_1213k32" />
    <bpmn:sequenceFlow id="Flow_CapSo_ToAuditLog" sourceRef="Task_CapSoVaGhiNhan" targetRef="Task_GhiAuditLog_Xuat" />
    <bpmn:sequenceFlow id="Flow_AuditLogX_ToEnd" sourceRef="Task_GhiAuditLog_Xuat" targetRef="End_XuatThanhCong" />
    <bpmn:sequenceFlow id="Flow_LoiThangX_ToEnd" sourceRef="Boundary_ThangKhoa_Xuat" targetRef="End_LoiThangKhoa_Xuat" />
    <bpmn:sequenceFlow id="Flow_LoiACQT_ToEnd" sourceRef="Boundary_LoiACQT" targetRef="End_LoiACQT" />
    <bpmn:sequenceFlow id="Flow_LoiKho_ToEnd" sourceRef="Boundary_LoiKho" targetRef="End_LoiTonKho" />
    <bpmn:sequenceFlow id="Flow_LoiDuLieu_ToEnd" sourceRef="Boundary_LoiDuLieu_Xuat" targetRef="End_LoiDuLieu_Xuat" />
    <bpmn:exclusiveGateway id="Gateway_1213k32">
      <bpmn:incoming>Flow_ConTon_ToCapSo</bpmn:incoming>
      <bpmn:incoming>Flow_HetTon_ToCapSo</bpmn:incoming>
      <bpmn:outgoing>Flow_16cn2k2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_16cn2k2" sourceRef="Gateway_1213k32" targetRef="Task_CapSoVaGhiNhan" />
    <bpmn:textAnnotation id="TextAnnotation_Xuat_Nhap">
      <bpmn:text>Thông tin phiếu xuất :
- Ngày xuất (mặc định hiện tại).
- Nơi xuất (Kho vật tư), Nơi nhận (Đơn vị đề nghị).
- Lý do xuất, Chi tiết: Tên hàng, Số lượng (&gt; 0).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Xuat_ThangKhoa">
      <bpmn:text>Kiểm tra kỳ kế toán khóa tháng:
- Nếu tháng đã khóa: ném ERR_MONTH_LOCKED.
- Nếu tháng mở: cho phép tiếp tục.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Xuat_ACQT">
      <bpmn:text>Quy tắc đặc biệt ACQT :
- ACQT luôn phải lập phiếu xuất riêng.
- Không gộp ACQT chung với VPP, ACTT, VLK.
- Vi phạm: ném ERR_ACQT_MIXING.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Xuat_TonKho">
      <bpmn:text>Kiểm tra tồn kho &amp; Đơn giá :
1. Số lượng xuất &gt; 0 và &lt;= tồn kho.
2. Đơn giá = ROUND(Tiền tồn / SL tồn, 0).
3. Xác định: còn tồn hay xuất hết tồn.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Xuat_ConTon">
      <bpmn:text>Xuất còn tồn (SL tồn sau xuất &gt; 0):
- Thành tiền = SL xuất × Đơn giá bình quân.
- Tổng cộng = Tổng thành tiền các dòng.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Xuat_HetTon">
      <bpmn:text>Xuất hết tồn (SL tồn sau xuất = 0):
- Cảnh báo nếu tồn SL = 0 nhưng tiền khác 0.
- Thành tiền xuất = toàn bộ tiền tồn trong thẻ kho để tiền tồn về đúng 0.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Xuat_CapSo">
      <bpmn:text>Cấp số &amp; Ghi thẻ kho, KKTS :
1. Cấp số STT/NHÓM-YYYY (nhóm đại diện).
2. Ghi Thẻ kho trừ tồn kho (SL tồn, tiền tồn).
3. Cập nhật số liệu Bảng kê KKTS kỳ hiện tại.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Xuat_AuditLog">
      <bpmn:text>Ghi nhận Audit Log hệ thống:
Người xuất, số phiếu, nơi nhận, lý do, tổng tiền, thời gian.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Xuat_Nhap" sourceRef="Task_NhapThongTinPhieuXuat" targetRef="TextAnnotation_Xuat_Nhap" />
    <bpmn:association id="Association_Xuat_ThangKhoa" sourceRef="Task_KiemTraThangKhoa_Xuat" targetRef="TextAnnotation_Xuat_ThangKhoa" />
    <bpmn:association id="Association_Xuat_ACQT" sourceRef="Boundary_LoiACQT" targetRef="TextAnnotation_Xuat_ACQT" />
    <bpmn:association id="Association_Xuat_TonKho" sourceRef="Task_KiemTraTonKho" targetRef="TextAnnotation_Xuat_TonKho" />
    <bpmn:association id="Association_Xuat_ConTon" sourceRef="Task_TinhThanhTienConTon" targetRef="TextAnnotation_Xuat_ConTon" />
    <bpmn:association id="Association_Xuat_HetTon" sourceRef="Task_TinhThanhTienHetTon" targetRef="TextAnnotation_Xuat_HetTon" />
    <bpmn:association id="Association_Xuat_CapSo" sourceRef="Task_CapSoVaGhiNhan" targetRef="TextAnnotation_Xuat_CapSo" />
    <bpmn:association id="Association_Xuat_AuditLog" sourceRef="Task_GhiAuditLog_Xuat" targetRef="TextAnnotation_Xuat_AuditLog" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_XuatAnPham">
    <bpmndi:BPMNPlane id="BPMNPlane_XuatAnPham" bpmnElement="Process_XuatAnPham">
      <bpmndi:BPMNShape id="LaneSet_Xuat_di" bpmnElement="Lane_NguoiDung_Xuat" isHorizontal="true">
        <dc:Bounds x="160" y="180" width="1930" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_HeThong_Xuat_di" bpmnElement="Lane_HeThong_Xuat" isHorizontal="true">
        <dc:Bounds x="160" y="380" width="1930" height="430" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Xuat_di" bpmnElement="Start_Xuat" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="222" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="197" y="305" width="88" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NhapThongTinPhieuXuat_di" bpmnElement="Task_NhapThongTinPhieuXuat" bioc:stroke="#0d4372" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d4372">
        <dc:Bounds x="320" y="240" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_KiemTraThangKhoa_Xuat_di" bpmnElement="Task_KiemTraThangKhoa_Xuat" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="510" y="440" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_KiemTraACQT_di" bpmnElement="Task_KiemTraACQT" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="710" y="440" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_KiemTraTonKho_di" bpmnElement="Task_KiemTraTonKho" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="910" y="440" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_KiemTraTon_di" bpmnElement="GW_KiemTraTon" isMarkerVisible="true">
        <dc:Bounds x="1110" y="455" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1170" y="473" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TinhThanhTienConTon_di" bpmnElement="Task_TinhThanhTienConTon" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="1220" y="397" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TinhThanhTienHetTon_di" bpmnElement="Task_TinhThanhTienHetTon" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="1210" y="530" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CapSoVaGhiNhan_di" bpmnElement="Task_CapSoVaGhiNhan" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="1555" y="440" width="160" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GhiAuditLog_Xuat_di" bpmnElement="Task_GhiAuditLog_Xuat" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="1815" y="440" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_XuatThanhCong_di" bpmnElement="End_XuatThanhCong" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="2042" y="462" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2018" y="505" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_LoiThangKhoa_Xuat_di" bpmnElement="End_LoiThangKhoa_Xuat" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="567" y="600" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="542" y="643" width="89" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_LoiACQT_di" bpmnElement="End_LoiACQT" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="767" y="600" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="745" y="643" width="82" height="27" />
