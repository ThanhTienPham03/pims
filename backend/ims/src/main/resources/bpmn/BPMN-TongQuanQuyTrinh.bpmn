      <bpmn:serviceTask id="Import_HeaderValidate" name="Kiểm tra thông tin phiếu nhập" camunda:delegateExpression="${genericTaskDelegate}">
        <bpmn:extensionElements>
          <zeebe:script expression="=ngayNhap != null and &#10;noiNhap != null and &#10;noiMua != null and &#10;tkNo != null and &#10;tkCo != null and &#10;sttTiepTheo != null and sttTiepTheo &#62; 0 and &#10;items != null and count(items) &#62; 0 and &#10;thangDaKhoa != true" resultVariable="importHeaderValid" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0qqdjmh</bpmn:incoming>
        <bpmn:outgoing>IF2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Import_Total" name="Tính tổng tiền nhập" camunda:delegateExpression="${genericTaskDelegate}">
        <bpmn:extensionElements>
          <zeebe:script expression="= sum(for item in items return item.soLuong * item.donGia)" resultVariable="tongTien" />
        </bpmn:extensionElements>
        <bpmn:incoming>IF_ItemsOk</bpmn:incoming>
        <bpmn:outgoing>IF_TotalNext</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Import_HeaderGW" name="Thông tin hợp lệ?" default="IF_Invalid">
        <bpmn:incoming>IF2</bpmn:incoming>
        <bpmn:outgoing>IF_Invalid</bpmn:outgoing>
        <bpmn:outgoing>IF_HeaderOk</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="Import_ItemsGW" name="Tất cả mặt hàng hợp lệ?" default="IF_InvalidItems">
        <bpmn:incoming>IF_ItemsCheck</bpmn:incoming>
        <bpmn:outgoing>IF_ItemsOk</bpmn:outgoing>
        <bpmn:outgoing>IF_InvalidItems</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Import_Group" name="Xác định nhóm để cấp số" camunda:delegateExpression="${genericTaskDelegate}">
        <bpmn:extensionElements>
          <zeebe:script expression="= if count(items[nhomHang = &#34;ACQT&#34;]) &#62; 0 &#10;   then &#34;ACQT&#34; &#10; else if count(items[nhomHang = &#34;VPP&#34;]) &#62; count(items[nhomHang = &#34;ACTT&#34;]) &#10;   then &#34;VPP&#34; &#10; else if count(items[nhomHang = &#34;ACTT&#34;]) &#62; 0 &#10;   then &#34;ACTT&#34; else &#34;VLK&#34;" resultVariable="nhomDaiDien" />
        </bpmn:extensionElements>
        <bpmn:incoming>IF_TotalNext</bpmn:incoming>
        <bpmn:outgoing>IF_GroupNext</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Import_Number" name="Cấp số phiếu" camunda:delegateExpression="${genericTaskDelegate}">
        <bpmn:extensionElements>
          <zeebe:script expression="= string(sttTiepTheo) + &#34;/&#34; + string(nhomDaiDien) + &#34;-&#34; + substring(ngayNhap, 1, 4)" resultVariable="soPhieu" />
        </bpmn:extensionElements>
        <bpmn:incoming>IF_GroupNext</bpmn:incoming>
        <bpmn:outgoing>Flow_0dd2uoo</bpmn:outgoing>
        <bpmn:property id="Property_0h374vi" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="DataInputAssociation_1pi7bxc">
          <bpmn:sourceRef>DataStoreReference_0n8s9ie</bpmn:sourceRef>
          <bpmn:targetRef>Property_0h374vi</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataOutputAssociation id="DataOutputAssociation_0ncpz4k">
          <bpmn:targetRef>DataStoreReference_0n8s9ie</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Import_Record" name="Ghi nhận phiếu nhập" camunda:delegateExpression="${genericTaskDelegate}">
        <bpmn:extensionElements>
          <zeebe:script expression="= {&#10;   &#34;soPhieu&#34;: soPhieu,&#10;   &#34;loaiPhieu&#34;: &#34;NHAP&#34;, &#10;   &#34;ngayNhap&#34;: ngayNhap, &#10;   &#34;items&#34;: items, &#10;   &#34;tongTien&#34;: tongTien,&#10;   &#34;noiNhap&#34;: noiNhap, &#10;   &#34;noiMua&#34;: noiMua, &#10;   &#34;soHoaDon&#34;: soHoaDon, &#10;   &#34;tkNo&#34;: tkNo,&#10;   &#34;tkCo&#34;: tkCo,&#10;   &#34;nhomDaiDien&#34;: nhomDaiDien&#10; }" resultVariable="phieuNhap" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0boiokv</bpmn:incoming>
        <bpmn:outgoing>IF_RecordNext</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Import_UpdateStock" name="Cập nhật tồn kho và thẻ kho" camunda:delegateExpression="${genericTaskDelegate}">
        <bpmn:extensionElements>
          <zeebe:script expression="= true" resultVariable="importStockUpdated" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1y2uc6e</bpmn:incoming>
        <bpmn:outgoing>Flow_0a40wf0</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:startEvent id="Start_Import" name="Bắt đầu nhập">
        <bpmn:outgoing>Flow_1qlunqg</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Activity_12gvm8z" name="Nhập Phiếu" camunda:delegateExpression="${genericTaskDelegate}">
        <bpmn:incoming>Flow_1qlunqg</bpmn:incoming>
        <bpmn:outgoing>Flow_0qqdjmh</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:subProcess id="Import_MI" name="Kiểm tra mặt hàng">
        <bpmn:incoming>IF_HeaderOk</bpmn:incoming>
        <bpmn:outgoing>IF_ItemsCheck</bpmn:outgoing>
        <bpmn:property id="Property_1ohbnlq" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="DataInputAssociation_0m6v0vz">
          <bpmn:sourceRef>DataStoreReference_0n8s9ie</bpmn:sourceRef>
          <bpmn:targetRef>Property_1ohbnlq</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataOutputAssociation id="DataOutputAssociation_1hjcd3k">
          <bpmn:targetRef>DataStoreReference_0n8s9ie</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="${items}" camunda:elementVariable="item" />
        <bpmn:startEvent id="Import_MI_Start">
          <bpmn:outgoing>Flow_1ihq299</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:serviceTask id="Import_MI_Check" name="Kiểm tra SL và đơn giá" camunda:delegateExpression="${genericTaskDelegate}">
          <bpmn:extensionElements>
            <zeebe:script expression="=item.soLuong != null and &#10;item.soLuong &#62; 0 and &#10;item.donGia != null and &#10;item.donGia &#62; 0" resultVariable="itemValid" />
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_1ihq299</bpmn:incoming>
          <bpmn:outgoing>IM2</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="Import_MI_End">
          <bpmn:incoming>IM2</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_1ihq299" sourceRef="Import_MI_Start" targetRef="Import_MI_Check" />
        <bpmn:sequenceFlow id="IM2" sourceRef="Import_MI_Check" targetRef="Import_MI_End" />
      </bpmn:subProcess>
