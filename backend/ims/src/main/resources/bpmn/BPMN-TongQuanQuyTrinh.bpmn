    <bpmn:subProcess id="Sub_Export" name="Quy trình xuất ấn phẩm">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=soPhieu" target="soPhieu" />
          <zeebe:output source="=tongTien" target="tongTien" />
          <zeebe:output source="=nhomDaiDien" target="nhomDaiDien" />
          <zeebe:output source="=phieuXuat" target="phieuXuat" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Request_Export</bpmn:incoming>
      <bpmn:outgoing>Flow_Export_Log</bpmn:outgoing>
      <bpmn:startEvent id="Start_Export" name="Bắt đầu xuất">
        <bpmn:outgoing>Flow_0denux8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Export_HeaderValidate" name="Kiểm tra thông tin phiếu xuất" camunda:delegateExpression="${genericTaskDelegate}">
        <bpmn:extensionElements>
          <zeebe:script expression="=ngayXuat != null and &#10;noiNhan != null and &#10;lyDoXuat != null and &#10;tkNo != null and &#10;tkCo != null and &#10;items != null and &#10;count(items) &#62; 0 and (thangDaKhoa != true)" resultVariable="exportHeaderValid" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0l9ec89</bpmn:incoming>
        <bpmn:outgoing>EF2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Export_ACQTCheck" name="Kiểm tra quy tắc ACQT" camunda:delegateExpression="${genericTaskDelegate}">
        <bpmn:extensionElements>
          <zeebe:script expression="= not(&#10;   count(items[nhomHang = &#34;ACQT&#34;]) &#62; 0 and &#10;   count(distinct values(for i in items return i.nhomHang)) &#62; 1&#10; )" resultVariable="acqtValid" />
        </bpmn:extensionElements>
        <bpmn:incoming>EF_HeaderOk</bpmn:incoming>
        <bpmn:outgoing>EF3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Export_HeaderGW" name="Phiếu hợp lệ và tháng chưa khóa?" default="EF_Invalid">
        <bpmn:incoming>EF2</bpmn:incoming>
        <bpmn:outgoing>EF_HeaderOk</bpmn:outgoing>
        <bpmn:outgoing>EF_Invalid</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="Export_ACQTGW" name="ACQT hợp lệ?" default="EF_ACQTInvalid">
        <bpmn:incoming>EF3</bpmn:incoming>
        <bpmn:outgoing>EF_ACQTInvalid</bpmn:outgoing>
        <bpmn:outgoing>EF_ACQTOk</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="Export_ItemsGW" name="Tất cả dòng xuất hợp lệ?" default="EF_ItemsInvalid">
        <bpmn:incoming>EF4</bpmn:incoming>
        <bpmn:outgoing>EF_ItemsInvalid</bpmn:outgoing>
        <bpmn:outgoing>EF_ItemsOk</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Export_Calc" name="Tính tổng tiền xuất" camunda:delegateExpression="${genericTaskDelegate}">
        <bpmn:extensionElements>
          <zeebe:script expression="= sum(&#10;   for item in items &#10;   return &#10;     if item.soLuong = item.tonSoLuong&#10;        then item.tonThanhTien &#10;     else item.soLuong * item.donGiaXuat&#10; )" resultVariable="tongTien" />
        </bpmn:extensionElements>
        <bpmn:incoming>EF_ItemsOk</bpmn:incoming>
        <bpmn:outgoing>EF5</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Export_Group" name="Xác định nhóm đại diện" camunda:delegateExpression="${genericTaskDelegate}">
        <bpmn:extensionElements>
          <zeebe:script expression="= if count(items[nhomHang = &#34;ACQT&#34;]) &#62; 0 &#10;   then &#34;ACQT&#34; &#10; else if count(items[nhomHang = &#34;VPP&#34;]) = 0 and count(items[nhomHang = &#34;ACTT&#34;]) = 0 &#10;   then &#34;VLK&#34; &#10; else if count(items[nhomHang = &#34;VPP&#34;]) &#62;= count(items[nhomHang = &#34;ACTT&#34;]) &#10;   then &#34;VPP&#34; &#10; else &#34;ACTT&#34;" resultVariable="nhomDaiDien" />
        </bpmn:extensionElements>
        <bpmn:incoming>EF5</bpmn:incoming>
        <bpmn:outgoing>EF6</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Export_Number" name="Cấp số phiếu xuất" camunda:delegateExpression="${genericTaskDelegate}">
        <bpmn:extensionElements>
          <zeebe:script expression="= string(sttTiepTheo) + &#34;/&#34; + nhomDaiDien + &#34;-&#34; + string(year(date(ngayXuat)))" resultVariable="soPhieu" />
        </bpmn:extensionElements>
        <bpmn:incoming>EF6</bpmn:incoming>
        <bpmn:outgoing>EF7</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Export_Record" name="Ghi nhận phiếu xuất" camunda:delegateExpression="${genericTaskDelegate}">
        <bpmn:extensionElements>
          <zeebe:script expression="= {&#10;   &#34;soPhieu&#34;: soPhieu, &#10;   &#34;loaiPhieu&#34;: &#34;XUAT&#34;, &#10;   &#34;ngayXuat&#34;: ngayXuat, &#10;   &#34;noiNhan&#34;: noiNhan, &#10;   &#34;lyDoXuat&#34;: lyDoXuat, &#10;   &#34;tkNo&#34;: tkNo,&#10;   &#34;tkCo&#34;: tkCo, &#10;   &#34;items&#34;: items, &#10;   &#34;tongTien&#34;: tongTien, &#10;   &#34;nhomDaiDien&#34;: nhomDaiDien&#10; }" resultVariable="phieuXuat" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1kmv9f4</bpmn:incoming>
        <bpmn:outgoing>EF8</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Export_UpdateStock" name="Cập nhật tồn kho và thẻ kho" camunda:delegateExpression="${genericTaskDelegate}">
        <bpmn:extensionElements>
          <zeebe:script expression="= true" resultVariable="exportStockUpdated" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0efi2x0</bpmn:incoming>
        <bpmn:outgoing>Flow_0myiqgu</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Export_UpdateKKTS" name="Cập nhật bảng kê KKTS" camunda:delegateExpression="${genericTaskDelegate}">
        <bpmn:extensionElements>
          <zeebe:script expression="= true" resultVariable="exportKKTSUpdated" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0h6am7j</bpmn:incoming>
        <bpmn:outgoing>Flow_0yjgyfj</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_Export" name="Xuất thành công">
        <bpmn:incoming>Flow_0jxwkpu</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="Activity_1tvmalx" name="Lưu thông tin  bảng KKTS vào  CSDL" camunda:delegateExpression="${genericTaskDelegate}">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="save" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1trmp4j</bpmn:incoming>
        <bpmn:outgoing>Flow_1krfdpl</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DataOutputAssociation_0ga9co3">
          <bpmn:targetRef>DataStoreReference_0i6tj8j</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:serviceTask>
      <bpmn:subProcess id="Export_MI" name="Kiểm tra từng mặt hàng xuất">
        <bpmn:incoming>EF_ACQTOk</bpmn:incoming>
        <bpmn:outgoing>EF4</bpmn:outgoing>
        <bpmn:property id="Property_11xssly" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="DataInputAssociation_17etxvo">
          <bpmn:sourceRef>DataStore-check</bpmn:sourceRef>
          <bpmn:targetRef>Property_11xssly</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataOutputAssociation id="DataOutputAssociation_1xxtrr0">
          <bpmn:targetRef>DataStore-check</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="${items}" camunda:elementVariable="item" />
        <bpmn:startEvent id="Export_MI_Start">
          <bpmn:outgoing>XM1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:serviceTask id="Export_MI_Check" name="Kiểm tra tồn và đơn giá xuất" camunda:delegateExpression="${genericTaskDelegate}">
          <bpmn:extensionElements>
            <zeebe:script expression="=item.soLuong != null and &#10;item.soLuong &#62; 0 and &#10;item.tonSoLuong != null and &#10;item.soLuong &#60;= item.tonSoLuong and &#10;item.donGiaXuat != null and &#10;item.donGiaXuat &#62;= 0" resultVariable="itemExportValid" />
          </bpmn:extensionElements>
          <bpmn:incoming>XM1</bpmn:incoming>
          <bpmn:outgoing>XM2</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="Export_MI_End">
          <bpmn:incoming>XM2</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="XM1" sourceRef="Export_MI_Start" targetRef="Export_MI_Check" />
        <bpmn:sequenceFlow id="XM2" sourceRef="Export_MI_Check" targetRef="Export_MI_End" />
      </bpmn:subProcess>
