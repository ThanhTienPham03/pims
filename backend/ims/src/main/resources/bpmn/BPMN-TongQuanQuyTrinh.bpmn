    <bpmn:subProcess id="Sub_CloseMonth" name="Chốt và khóa tháng">
      <bpmn:incoming>Flow_Request_Close</bpmn:incoming>
      <bpmn:outgoing>Flow_Close_Log</bpmn:outgoing>
      <bpmn:serviceTask id="Close_CalcKKTS" name="Tính bảng kê cuối tháng" camunda:delegateExpression="${genericTaskDelegate}">
        <bpmn:extensionElements>
          <zeebe:script expression="= if soLuongTonCuoiKy = 0 then {&#10;   &#34;soLuong&#34;: 0, &#10;   &#34;donGia&#34;: 0, &#10;   &#34;thanhTien&#34;: 0} &#10; else {&#10;   &#34;soLuong&#34;: soLuongTonCuoiKy,&#10;   &#34;donGia&#34;: round(thanhTienTonCuoiKy / soLuongTonCuoiKy, 0),&#10;   &#34;thanhTien&#34;: thanhTienTonCuoiKy&#10; }" resultVariable="kktsCuoiThang" />
        </bpmn:extensionElements>
