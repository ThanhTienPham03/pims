        <dc:Bounds x="1245" y="565" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_LoiDuLieu_di" bpmnElement="End_LoiDuLieu" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="1032" y="697" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1010" y="740" width="81" height="40" />
