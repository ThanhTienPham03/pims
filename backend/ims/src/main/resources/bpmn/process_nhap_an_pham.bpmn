<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_NhapAnPham" targetNamespace="http://saigonbank.fit/ims/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:error id="Error_ThangDaKhoa" name="Lỗi tháng đã khóa" errorCode="ERR_MONTH_LOCKED" />
  <bpmn:error id="Error_DuLieuKhongHopLe" name="Lỗi dữ liệu nhập không hợp lệ" errorCode="ERR_INVALID_IMPORT" />
  <bpmn:process id="Process_NhapAnPham" name="Quy Trình Nhập Ấn Phẩm" isExecutable="true" camunda:historyTimeToLive="365">
    <bpmn:laneSet id="LaneSet_Nhap">
      <bpmn:lane id="Lane_NguoiDung" name="Người Lập Phiếu / Kế Toán Kho">
        <bpmn:flowNodeRef>Start_Nhap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NhapThanhCong</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HeThong" name="Hệ Thống IMS (Tự động)">
        <bpmn:flowNodeRef>Task_KiemTraThangKhoa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_LoiThangKhoa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_LoiDuLieu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_ThangKhoa_Nhap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GhiAuditLog_Nhap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KiemTraVaGhiNhanNhap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_LoiDuLieu_Nhap</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Nhap" name="1. Tạo phiếu nhập ấn phẩm">
      <bpmn:documentation>
        Người dùng nhập thông tin phiếu:
        - Ngày nhập (mặc định ngày hiện tại).
        - Nơi nhập (mặc định Kho vật tư).
        - Nơi mua (nhà cung cấp).
        - Nhập theo HĐ (số hóa đơn, ngày HĐ).
        - TK Nợ, TK Có.
        - Chi tiết: Chọn Tên hàng từ danh mục, nhập Số lượng (&gt; 0) và Đơn giá hóa đơn.
      </bpmn:documentation>
      <bpmn:outgoing>Flow_Start_ToKiemTraThang</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_KiemTraThangKhoa" name="2. Kiểm tra trạng thái khóa tháng" camunda:delegateExpression="${genericTaskDelegate}">
      <bpmn:documentation>
        Hệ thống kiểm tra kỳ kế toán của Ngày nhập:
        - Nếu tháng đã chốt khóa: ném ERR_MONTH_LOCKED, chặn không cho ghi nhận.
        - Nếu tháng chưa khóa: cho phép tiếp tục luồng ghi nhận.
      </bpmn:documentation>
      <bpmn:incoming>Flow_Start_ToKiemTraThang</bpmn:incoming>
      <bpmn:outgoing>Flow_ThangHopLe_ToGhiNhan</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_ThangKhoa_Nhap" attachedToRef="Task_KiemTraThangKhoa">
      <bpmn:documentation>Kỳ kế toán đã bị khóa bởi Kiểm soát viên.</bpmn:documentation>
      <bpmn:outgoing>Flow_LoiThang_ToEnd</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_ThangKhoa_Nhap" errorRef="Error_ThangDaKhoa" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_KiemTraVaGhiNhanNhap" name="3. Cấp số STT/NHÓM-YYYY &#38; Ghi thẻ kho, KKTS" camunda:delegateExpression="${importProcessDelegate}">
      <bpmn:documentation>
        Hệ thống xử lý tự động ngay khi lưu (không cần duyệt):
        1. Tự lấy Mã số, Nhóm hàng (VPP/ACTT/ACQT/VLK), ĐVT từ danh mục.
        2. Tính Thành tiền = Số lượng × Đơn giá nhập; Tính tổng cộng tiền và số tiền bằng chữ.
        3. Cấp số phiếu theo định dạng STT/NHÓM HÀNG-YYYY (reset theo năm).
        4. Cập nhật tồn kho tức thì: Ghi Thẻ kho từng mã hàng và cập nhật Bảng kê KKTS/tồn kho.
      </bpmn:documentation>
      <bpmn:incoming>Flow_ThangHopLe_ToGhiNhan</bpmn:incoming>
      <bpmn:outgoing>Flow_GhiNhan_ToAuditLog</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_LoiDuLieu_Nhap" attachedToRef="Task_KiemTraVaGhiNhanNhap">
      <bpmn:documentation>Số lượng &lt;= 0, thiếu đơn giá, hoặc dữ liệu không hợp lệ.</bpmn:documentation>
      <bpmn:outgoing>Flow_LoiDuLieu_ToEnd</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_DuLieu_Nhap" errorRef="Error_DuLieuKhongHopLe" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_GhiAuditLog_Nhap" name="4. Ghi nhận Audit Log" camunda:delegateExpression="${genericTaskDelegate}">
      <bpmn:documentation>
        Ghi nhật ký kiểm toán hệ thống: người tạo, số phiếu, ngày giờ thực hiện, số tiền.
      </bpmn:documentation>
      <bpmn:incoming>Flow_GhiNhan_ToAuditLog</bpmn:incoming>
      <bpmn:outgoing>Flow_AuditLog_ToInPhieu</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_NhapThanhCong" name="Hoàn tất nhập kho">
      <bpmn:incoming>Flow_AuditLog_ToInPhieu</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_LoiThangKhoa" name="Từ chối: Tháng đã khóa sổ">
      <bpmn:incoming>Flow_LoiThang_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_LoiDuLieu" name="Từ chối: Dữ liệu nhập không hợp lệ">
      <bpmn:incoming>Flow_LoiDuLieu_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_ToKiemTraThang" sourceRef="Start_Nhap" targetRef="Task_KiemTraThangKhoa" />
    <bpmn:sequenceFlow id="Flow_ThangHopLe_ToGhiNhan" sourceRef="Task_KiemTraThangKhoa" targetRef="Task_KiemTraVaGhiNhanNhap" />
    <bpmn:sequenceFlow id="Flow_GhiNhan_ToAuditLog" sourceRef="Task_KiemTraVaGhiNhanNhap" targetRef="Task_GhiAuditLog_Nhap" />
    <bpmn:sequenceFlow id="Flow_AuditLog_ToInPhieu" sourceRef="Task_GhiAuditLog_Nhap" targetRef="End_NhapThanhCong" />
    <bpmn:sequenceFlow id="Flow_LoiThang_ToEnd" sourceRef="Boundary_ThangKhoa_Nhap" targetRef="End_LoiThangKhoa" />
    <bpmn:sequenceFlow id="Flow_LoiDuLieu_ToEnd" sourceRef="Boundary_LoiDuLieu_Nhap" targetRef="End_LoiDuLieu" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_NhapAnPham">
    <bpmndi:BPMNPlane id="BPMNPlane_NhapAnPham" bpmnElement="Process_NhapAnPham">
      <bpmndi:BPMNShape id="Lane_HeThong_di" bpmnElement="Lane_HeThong" isHorizontal="true">
        <dc:Bounds x="160" y="260" width="1020" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_NguoiDung_di" bpmnElement="Lane_NguoiDung" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="1020" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Nhap_di" bpmnElement="Start_Nhap">
        <dc:Bounds x="222" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="200" y="185" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_KiemTraThangKhoa_di" bpmnElement="Task_KiemTraThangKhoa" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="320" y="320" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_NhapThanhCong_di" bpmnElement="End_NhapThanhCong" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="1082" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1056" y="185" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_LoiThangKhoa_di" bpmnElement="End_LoiThangKhoa" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="402" y="452" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="376" y="495" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_LoiDuLieu_di" bpmnElement="End_LoiDuLieu" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="612" y="452" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="591" y="495" width="81" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GhiAuditLog_Nhap_di" bpmnElement="Task_GhiAuditLog_Nhap" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="785" y="320" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_KiemTraVaGhiNhanNhap_di" bpmnElement="Task_KiemTraVaGhiNhanNhap" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="535" y="320" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_ThangKhoa_Nhap_di" bpmnElement="Boundary_ThangKhoa_Nhap">
        <dc:Bounds x="402" y="382" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_LoiDuLieu_Nhap_di" bpmnElement="Boundary_LoiDuLieu_Nhap">
        <dc:Bounds x="637" y="382" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_ToKiemTraThang_di" bpmnElement="Flow_Start_ToKiemTraThang">
        <di:waypoint x="258" y="160" />
        <di:waypoint x="289" y="160" />
        <di:waypoint x="289" y="360" />
        <di:waypoint x="320" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ThangHopLe_ToGhiNhan_di" bpmnElement="Flow_ThangHopLe_ToGhiNhan">
        <di:waypoint x="450" y="360" />
        <di:waypoint x="535" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_GhiNhan_ToAuditLog_di" bpmnElement="Flow_GhiNhan_ToAuditLog">
        <di:waypoint x="685" y="360" />
        <di:waypoint x="785" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AuditLog_ToInPhieu_di" bpmnElement="Flow_AuditLog_ToInPhieu">
        <di:waypoint x="915" y="360" />
        <di:waypoint x="979" y="360" />
        <di:waypoint x="979" y="160" />
        <di:waypoint x="1082" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_LoiThang_ToEnd_di" bpmnElement="Flow_LoiThang_ToEnd">
        <di:waypoint x="420" y="418" />
        <di:waypoint x="420" y="452" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_LoiDuLieu_ToEnd_di" bpmnElement="Flow_LoiDuLieu_ToEnd">
        <di:waypoint x="655" y="418" />
        <di:waypoint x="655" y="435" />
        <di:waypoint x="630" y="435" />
        <di:waypoint x="630" y="452" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
