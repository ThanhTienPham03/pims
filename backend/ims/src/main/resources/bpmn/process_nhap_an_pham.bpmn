        <dc:Bounds x="175" y="850" width="320" height="85" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TextAnnotation_KiemTraThang_di" bpmnElement="TextAnnotation_KiemTraThang">
        <dc:Bounds x="680" y="850" width="290" height="110" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
