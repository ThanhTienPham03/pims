      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="TextAnnotation_NhapThongTin_di" bpmnElement="TextAnnotation_NhapThongTin">
        <dc:Bounds x="150" y="80" width="410" height="110" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TextAnnotation_ChonHang_di" bpmnElement="TextAnnotation_ChonHang">
        <dc:Bounds x="520" y="200" width="260" height="50" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
