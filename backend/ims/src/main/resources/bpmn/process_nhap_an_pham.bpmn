        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TextAnnotation_GhiAuditLog_di" bpmnElement="TextAnnotation_GhiAuditLog">
        <dc:Bounds x="1420" y="555" width="100" height="100" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_LoiDuLieu_Nhap_di" bpmnElement="Boundary_LoiDuLieu_Nhap" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="967" y="627" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_ThangKhoa_Nhap_di" bpmnElement="Boundary_ThangKhoa_Nhap" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="907" y="627" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_ToNhapThongTin_di" bpmnElement="Flow_Start_ToNhapThongTin">
        <di:waypoint x="348" y="370" />
        <di:waypoint x="385" y="370" />
      </bpmndi:BPMNEdge>
